# Project-local runtime and caches (about 10.5 GiB)
.runtime/
.cache/
.tmp/

# Downloaded datasets and official checkpoints are reproducible dependencies.
data/
checkpoints/

# User-supplied paper and screenshots are local reference material.
DPPO.pdf
图4.png
图18.png

# Generated Python state
__pycache__/
*.py[cod]

# Training checkpoints are excluded by default. A small, explicitly audited
# subset is force-added as key evidence in the initial publication.
logs/**/checkpoint/*.pt

# The complete P3-A raw run stays local (result.pkl and all checkpoints); the
# curated run.log and Hydra files are published under reports/evidence/.
logs/gym-finetune/hopper-medium-v2_ppo_diffusion_mlp_ta4_td20_tdf10/2026-09-11_20-11-30_42/

# P3-B IDQL raw run stays local; curated evidence is published under reports/evidence/.
logs/gym-finetune/hopper-medium-v2_idql_diffusion_mlp_ta4_td20/2026-09-12_11-03-24_42/

